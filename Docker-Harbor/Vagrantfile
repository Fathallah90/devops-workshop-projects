    har01.vm.provider "virtualbox" do |vb|
      #vb.gui = true
      vb.memory = "4096"
      vb.name = "Harbor"
    end
    # Harbor provisioning
    #har01.vm.provision "shell", path: "./scripts/Harbor.sh"
  end
end