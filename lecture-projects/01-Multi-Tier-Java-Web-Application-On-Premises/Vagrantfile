Vagrant.configure("2") do |config|
  config.hostmanager.enabled = true
  config.hostmanager.manage_host = true

  ### DB vm  ####
  config.vm.define "db01" do |db01|
    db01.vm.box = "Golden_CentOS_Final"
    #db01.vm.box_version = "9.0.43"
    db01.vm.hostname = "db01"
    db01.vm.network "private_network", ip: "192.168.56.10"

    db01.vm.provider "virtualbox" do |vb|
      vb.memory = "2048"
      vb.name = "MariaDB"
    end
    # MariaDB provisioning
    db01.vm.provision "shell", path: "./scripts/Database.sh"
  end

  ### Memcache vm  ####
  config.vm.define "mc01" do |mc01|
    mc01.vm.box = "Golden_CentOS_Final"
    #mc01.vm.box_version = "9.0.43"
    mc01.vm.hostname = "mc01"
    mc01.vm.network "private_network", ip: "192.168.56.11"
    mc01.vm.provider "virtualbox" do |vb|
      vb.memory = "1024"
      vb.name = "Memcached"
    end
    # Memcached provisioning
    mc01.vm.provision "shell", path: "./scripts/Memcached.sh"
  end

  ### RabbitMQ vm  ####
  config.vm.define "rmq01" do |rmq01|
    rmq01.vm.box = "Golden_CentOS_Final"
    #rmq01.vm.box_version = "9.0.43"
    rmq01.vm.hostname = "rmq01"
    rmq01.vm.network "private_network", ip: "192.168.56.12"
    rmq01.vm.provider "virtualbox" do |vb|
      vb.memory = "1024"
      vb.name = "RabbitMQ"
    end
    # RabbitMQ provisioning
    rmq01.vm.provision "shell", path: "./scripts/RabbitMQ.sh"
  end

  ###  maven vm ###
  config.vm.define "mv01" do |mv01|
    mv01.vm.box = "Golden_CentOS_Final"
    #mv01.vm.box_version = "9.0.43"
    mv01.vm.hostname = "mv01"
    mv01.vm.network "private_network", ip: "192.168.56.13"
    mv01.vm.provider "virtualbox" do |vb|
      vb.memory = "1024"
      vb.name = "Maven"
    end
    # Maven provisioning
    mv01.vm.provision "shell", path: "./scripts/Maven.sh"
  end

  ### tomcat vm ###
  config.vm.define "app01" do |app01|
    app01.vm.box = "Golden_CentOS_Final"
    #app01.vm.box_version = "9.0.43"
    app01.vm.hostname = "app01"
    app01.vm.network "private_network", ip: "192.168.56.14"
    app01.vm.provider "virtualbox" do |vb|
      vb.memory = "6144"
      vb.name = "Tomcat"
    end
    # Tomcat provisioning
    app01.vm.provision "shell", path: "./scripts/Tomcat.sh"
  end

  ### Nginx VM ###
  config.vm.define "web01" do |web01|
    web01.vm.box = "ubuntu/jammy64"
    web01.vm.hostname = "web01"
    web01.vm.network "private_network", ip: "192.168.56.15"
    web01.vm.provider "virtualbox" do |vb|
      vb.gui = true
      vb.memory = "1024"
      vb.name = "Nginx"
    end
    # Nginx provisioning
    web01.vm.provision "shell", path: "./scripts/Nginx.sh"
  end
end
